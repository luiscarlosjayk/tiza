#!/usr/bin/env python3
"""MCP context trials (t-161): guinea-pig agents, one task and one settings
variant each, connected to `tiza mcp` on a live Tiza of their own; the harness
measures the context they consume and checks their work through `tiza api`.

  scripts/agent-trials/run --dry-run                 # the plan: trials, fixtures, commands; no model, no Tiza
  scripts/agent-trials/run --self-check              # every check fails on the untouched fixture and passes
                                                     # after a scripted solution (no model)
  scripts/agent-trials/run --model sonnet --max-trials 14   # a real run (paid: asks to confirm the estimate)

Options:
  --model M          model for every trial (an alias such as sonnet, or a full name); required for a real run
  --max-trials N     cap on the trials run (the plan is repeats x tasks x variants, in that order)
  --repeats N        times each task x variant cell runs (default 2: tool search may load differently per run)
  --tasks a,b        only these tasks;  --variants a,b  only these variants
  --break TASK       break that task's fixture on purpose (its check must then fail whatever the agent says)
  --trial-budget USD per-trial cap passed as --max-budget-usd (default 1.00)
  --max-turns N      per-trial turn cap (default 40)
  --timeout S        per-trial wall-clock cap in seconds (default 600)
  --out DIR          where raw streams and results land (default scripts/agent-trials/runs/<stamp>, git-ignored)
  --tiza BIN         tiza binary (default: builds target/debug/tiza; a real run copies it into the run directory)
  --claude BIN       claude binary (default: claude on PATH, else ~/.local/bin/claude)
  --builtin-tools T  value for claude --tools (default ToolSearch: the only built-in tool, so the agent
                     cannot read files; `--tools ""` removes ToolSearch too, which the harness catches)
  --yes              do not ask before a real run (the estimate is still printed)
  --report DIR       re-read a run's raw streams with this version of the parser and rewrite its
                     summary (no model, no Tiza: the checks' verdicts are kept as they were)

Never part of `cargo test` or the gate: a real run calls a paid model. Each
trial runs in a fresh directory under /tmp holding only its fixture (so the
agent can read neither the repo nor the docs), with no CLAUDE.md, no auto
memory, no user settings, no skills and no MCP server but this trial's
`tiza mcp`. Results: docs/research/mcp-context.md. Stdlib only (python3 3.9+).
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import pty
import re
import shlex
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
FIXTURES = os.path.join(HERE, "fixtures")

SELF_REPORT = (
    "When you are done, end your answer with one line of the form "
    "`CONTEXT: <number> tokens - <one sentence>`: your own estimate of how much "
    "context this task used, and why."
)

# --------------------------------------------------------------- variants ----

# Settings variants. Each is the environment of the claude process on top of
# the isolation below; `expects_tool_search` is checked against the session's
# init message. Later cards (t-162, t-163) add theirs here and re-run the matrix.
VARIANTS = {
    "tool-search": {
        "desc": "today's server, tool search on (Claude Code's default: MCP tools deferred)",
        "env": {},
        "unset": ["ENABLE_TOOL_SEARCH"],
        "expects_tool_search": True,
    },
    "no-tool-search": {
        "desc": "today's server, tool search off (ENABLE_TOOL_SEARCH=false: every tool loaded upfront)",
        "env": {"ENABLE_TOOL_SEARCH": "false"},
        "unset": [],
        "expects_tool_search": False,
    },
}

# Isolation for every trial (documented Claude Code variables).
BASE_ENV = {
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
}

# ---------------------------------------------------------------- pricing ----

# USD per million tokens (input, output, cache read). Input and output from
# the Claude API model table cached 2026-10-06; Sonnet's cache read is what
# Claude Code's total_cost_usd showed in the Sonnet check run ($0.10/M; Opus fit $0.20/M), the
# others' are the table's. Claude Code writes the 1-hour cache, priced at 2 x
# input. Only for the estimate printed before a run: the measured cost is
# Claude Code's own `total_cost_usd`.
PRICES = {
    "fable": (10.0, 50.0, 0.25),
    "opus": (4.0, 20.0, 0.20),
    "sonnet": (2.0, 10.0, 0.10),
    "haiku": (0.10, 0.50, 0.01),
}
CACHE_WRITE = 2.0
# Assumed tokens per trial for the estimate: fresh input, cache writes,
# cache reads, output. The Sonnet 5.5 check run (16 trials) averaged
# 4.4k cache writes, 46k cache reads and 0.8k output per trial; these add
# headroom (about 2x) for longer tasks and other models.
TRIAL_TOKENS = (1_000, 8_000, 80_000, 1_500)


def price_of(model):
    m = (model or "").lower()
    for key, p in PRICES.items():
        if key in m:
            return key, p
    return None, None


def estimate(model, trials):
    key, p = price_of(model)
    if p is None:
        return None
    fresh, write, read, out = TRIAL_TOKENS
    per = (fresh * p[0] + write * p[0] * CACHE_WRITE + read * p[2] + out * p[1]) / 1e6
    return per, per * trials


# ------------------------------------------------------------------ tasks ----


class CheckFailed(Exception):
    pass


def need(cond, msg):
    if not cond:
        raise CheckFailed(msg)


def line_of(lines, needle, after=0):
    """1-based number of the first line (after line `after`) containing needle."""
    for i, text in enumerate(lines[after:], after + 1):
        if needle in text:
            return i
    raise CheckFailed("%r is not in the code" % needle)


def block_end(lines, start):
    """The line closing the block opened on line `start` (same indent + `}`)."""
    indent = len(lines[start - 1]) - len(lines[start - 1].lstrip())
    for i in range(start, len(lines)):
        if lines[i] == " " * indent + "}":
            return i + 1
    raise CheckFailed("no closing brace for line %d" % start)


def read_fixture(work, name):
    with open(os.path.join(work, name)) as f:
        return f.read().split("\n")


def anns(inst):
    return inst.api("scene.get")["document"].get("annotations", [])


def of_type(inst, kind):
    return [a for a in anns(inst) if a.get("type") == kind]


def lines_of(a):
    """The lines an annotation covers, as (first, last)."""
    if isinstance(a.get("from_line"), int):
        return a["from_line"], a.get("to_line", a["from_line"])
    ends = [a[k]["line"] for k in ("from", "to", "at", "span") if isinstance(a.get(k), dict) and "line" in a[k]]
    if isinstance(a.get("line"), int):
        ends.append(a["line"])
    return (min(ends), max(ends)) if ends else (None, None)


# Every task: the fixture it copies, the file Tiza opens, the prompt, the
# harness's check (raises CheckFailed), a scripted solution for --self-check
# (through the API, or the MCP bridge itself where the result depends on it)
# and what --break does to the fixture so that the check must fail:
# (file, old text, new text), or ("mkdir", name) for a directory in the way
# of a file the task writes. A check gets the trial record: the agent's final
# `answer` and its tool `calls` ({name, input, error}).


def check_read(inst, work, rec):
    # The truth is the fixture as opened, not the live state: an agent that
    # browses steps before answering still answers about where it started.
    with open(os.path.join(work, "stack.rs.tiza")) as f:
        doc = json.load(f)
    need(read_fixture(work, "stack.rs")[3].startswith("fn parse_args"), "line 4 is not fn parse_args")
    want = {"STEP": str(doc["step"]), "ANNOTATIONS": str(len(doc["annotations"])), "FUNCTION": "parse_args"}
    for key, value in want.items():
        got = re.findall(r"\b%s\s*=\s*`?([\w-]+)" % key, rec.get("answer") or "")
        need(got and got[-1] == value, "%s: want %s, answered %s" % (key, value, got[-1] if got else "nothing"))


def oracle_read(inst, work):
    status = inst.api("status")
    return {"answer": "STEP=%d\nANNOTATIONS=%d\nFUNCTION=parse_args" % (status["step"], len(anns(inst)))}


def check_box(inst, work, rec):
    lines = read_fixture(work, "stack.rs")
    start = line_of(lines, "fn push(")
    end = block_end(lines, start)
    boxes = [a for a in of_type(inst, "box") if a.get("step") == 1]
    need(boxes, "no box at step 1")
    ok = [b for b in boxes if b.get("from_line") == start and b.get("to_line") == end
          and "refuses when full" in (b.get("label") or "").lower()]
    need(ok, "no box %d-%d labelled «refuses when full» at step 1: %s" % (start, end, boxes))


def oracle_box(inst, work):
    lines = read_fixture(work, "stack.rs")
    start = line_of(lines, "fn push(")
    inst.api("annotation.add", {"type": "box", "from_line": start, "to_line": block_end(lines, start),
                                "label": "refuses when full", "step": 1})


def check_arrow_note(inst, work, rec):
    lines = read_fixture(work, "stack.rs")
    src = line_of(lines, "let max = parse_args")
    dst = line_of(lines, "Stack { items: Vec::new(), max }")
    arrows = [a for a in of_type(inst, "arrow") if a.get("step") == 2]
    need([a for a in arrows if a["from"]["line"] == src and a["to"]["line"] == dst],
         "no arrow L%d -> L%d at step 2: %s" % (src, dst, arrows))
    notes = [a for a in of_type(inst, "note") if a.get("step") == 2]
    need([n for n in notes if n.get("line") == src and "capacity" in (n.get("text") or "").lower()],
         "no note on L%d at step 2 about the capacity: %s" % (src, notes))


def oracle_arrow_note(inst, work):
    lines = read_fixture(work, "stack.rs")
    src = line_of(lines, "let max = parse_args")
    dst = line_of(lines, "Stack { items: Vec::new(), max }")
    inst.api("annotation.add", {"type": "arrow", "from": {"line": src, "find": "max"},
                                "to": {"line": dst, "find": "max }"}, "step": 2})
    inst.api("annotation.add", {"type": "note", "line": src, "text": "capacity comes from --max", "step": 2})


def check_move(inst, work, rec):
    lines = read_fixture(work, "stack.rs")
    anchor = line_of(lines, "let mut stack = Stack {")
    moves = inst.api("move.list")["moves"]
    typed = [m for m in moves if m.get("action") == "code.patch" and m.get("at_step") == 3
             and m.get("typing") == "char" and 'println!("stack is ready")' in (m.get("content") or "")]
    need(typed, "no code.patch at step 3 typed by char with the println: %s" % moves)
    inst.api("step.set", {"step": 3})
    code = [re.sub(r"^\s*\d+  ", "", ln) for ln in inst.api("code.get")["text"].split("\n")]
    need(len(code) > anchor and code[anchor].strip() == 'println!("stack is ready");',
         "at step 3 the line after L%d is %r" % (anchor, code[anchor] if len(code) > anchor else None))
    inst.api("step.set", {"step": 2})
    code = inst.api("code.get")["text"]
    need("stack is ready" not in code, "the line is there before step 3")


def oracle_move(inst, work):
    inst.api("move.add", {"action": "code.patch", "at_step": 3, "op": "insert",
                          "after": "let mut stack = Stack {", "typing": "char",
                          "content": '    println!("stack is ready");'})


def check_export(inst, work, rec):
    path = os.path.join(work, "step3.png")
    need(os.path.isfile(path), "no step3.png in the working directory")
    with open(path, "rb") as f:
        png = f.read()
    need(png[:8] == b"\x89PNG\r\n\x1a\n", "step3.png is not a PNG")
    # The fixture opens at step 2 and export_image defaults to the step on
    # screen, so a PNG is not enough: it must be step 3. References drawn by
    # the same bridge at its defaults tell; a PNG with other options (width,
    # theme) passes when the agent's own successful call named step 3.
    with tempfile.TemporaryDirectory(dir="/tmp") as tmp:
        with Bridge(inst.tiza, inst.sock, tmp) as b:
            refs = {s: b.call("export_image", {"path": "ref%d.png" % s, "step": s}) for s in (2, 3)}
        for s in (2, 3):
            need(not refs[s]["error"], "reference export of step %d failed: %s" % (s, refs[s]["text"]))
        ref = {s: open(os.path.join(tmp, "ref%d.png" % s), "rb").read() for s in (2, 3)}
    if png == ref[3]:
        return
    need(png != ref[2], "step3.png shows step 2 (the step on screen), not step 3")
    calls = [c for c in rec.get("calls", []) if c["name"].endswith("export_image") and not c["error"]
             and str(c["input"].get("path", "")).endswith("step3.png")]
    need([c for c in calls if str(c["input"].get("step")) == "3"],
         "step3.png differs from step 3 at the defaults and no export_image call named step 3: %s" % calls)


def oracle_export(inst, work):
    # Through the MCP bridge, as the agent would: a relative path lands in
    # the bridge's working directory, which is the trial's.
    with Bridge(inst.tiza, inst.sock, work) as b:
        r = b.call("export_image", {"path": "step3.png", "step": 3})
    need(not r["error"], "export_image failed: %s" % r["text"])
    return {"calls": [{"name": "mcp__tiza__export_image", "input": {"path": "step3.png", "step": 3},
                       "error": False}]}


def check_tour(inst, work, rec):
    main = read_fixture(work, "main.rs")
    queue = read_fixture(work, "queue.rs")
    mstart = line_of(main, "fn main(")
    qstart = line_of(queue, "pub fn push(")
    links = [m for m in inst.api("move.list")["moves"]
             if m.get("action") == "code.link" and m.get("at_step") == 2 and m.get("file", "").endswith("queue.rs")]
    need(links, "no code.link to queue.rs at step 2")
    boxes = of_type(inst, "box")
    need([b for b in boxes if b.get("step") == 1 and not b.get("file") and b.get("from_line") == mstart
          and b.get("to_line") == block_end(main, mstart) and "entry point" in (b.get("label") or "").lower()],
         "no box on main (main.rs L%d) labelled «entry point» at step 1: %s" % (mstart, boxes))
    need([b for b in boxes if b.get("step") == 2 and (b.get("file") or "").endswith("queue.rs")
          and b.get("from_line") == qstart and b.get("to_line") == block_end(queue, qstart)
          and "adds at the back" in (b.get("label") or "").lower()],
         "no box on push (queue.rs L%d) labelled «adds at the back» at step 2: %s" % (qstart, boxes))
    need(inst.api("check")["errors"] == 0, "check reports errors")


def oracle_tour(inst, work):
    main = read_fixture(work, "main.rs")
    queue = read_fixture(work, "queue.rs")
    mstart = line_of(main, "fn main(")
    qstart = line_of(queue, "pub fn push(")
    inst.api("annotation.add", {"type": "box", "from_line": mstart, "to_line": block_end(main, mstart),
                                "label": "entry point", "step": 1})
    inst.api("move.add", {"action": "code.link", "at_step": 2, "file": "queue.rs"})
    inst.api("annotation.add", {"type": "box", "from_line": qstart, "to_line": block_end(queue, qstart),
                                "label": "adds at the back", "step": 2})


def check_explain(inst, work, rec):
    # Free-form: every step 1-4 shows something new (an annotation, or a move
    # such as a select or a cursor), nothing goes past step 4, something is
    # about parse_args (its doc comment, its body or a line that calls it),
    # and the document has no errors.
    lines = read_fixture(work, "stack.rs")
    start = line_of(lines, "fn parse_args(")
    if start > 1 and lines[start - 2].lstrip().startswith("///"):
        start -= 1
    end = block_end(lines, line_of(lines, "fn parse_args("))
    about = {n for n in range(start, end + 1)} | {i for i, t in enumerate(lines, 1) if "parse_args" in t}
    all_anns = anns(inst)
    moves = inst.api("move.list")["moves"]
    steps = {a.get("step") for a in all_anns} | {m.get("at_step") for m in moves}
    need(steps >= {1, 2, 3, 4}, "steps with something new: %s, want 1-4" % sorted(steps))
    need(max(steps) == 4, "something at step %d, past the four steps" % max(steps))

    def touches(a):
        lo, hi = lines_of(a)
        return lo is not None and any(lo <= n <= hi for n in about)

    need([a for a in all_anns if touches(a)], "no annotation is on parse_args (L%d-%d) or a call to it" % (start, end))
    need(inst.api("check")["errors"] == 0, "check reports errors")


def oracle_explain(inst, work):
    lines = read_fixture(work, "stack.rs")
    start = line_of(lines, "fn parse_args(")
    inst.api("annotation.add", {"type": "box", "from_line": start, "to_line": block_end(lines, start),
                                "label": "parse_args", "step": 1})
    inst.api("annotation.add", {"type": "note", "line": start + 1, "text": "10 by default", "step": 2})
    inst.api("annotation.add", {"type": "highlight", "at": {"line": start + 4, "find": '"--max"'}, "step": 3})
    inst.api("annotation.add", {"type": "note", "line": block_end(lines, start) - 1, "text": "the result", "step": 4})


