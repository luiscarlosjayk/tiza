FIXTURE_DIRS = {"stack": "stack", "plain": "stack", "tour": "tour"}


def fixture_files(task):
    """Files copied into the trial directory ("plain" is the stack without its .tiza)."""
    src = os.path.join(FIXTURES, FIXTURE_DIRS[task["fixture"]])
    names = sorted(os.listdir(src))
    if task["fixture"] == "plain":
        names = [n for n in names if not n.endswith(".tiza")]
    return src, names


# --------------------------------------------------------------- instance ----


class Instance:
    """A live Tiza on a pseudo-terminal (120x40), with a socket of its own."""

    def __init__(self, tiza, work, open_file, sock):
        self.tiza, self.sock = tiza, sock
        pid, fd = pty.fork()
        if pid == 0:
            os.chdir(work)
            fcntl.ioctl(0, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))
            os.environ["TERM"] = "xterm-256color"
            os.execv(tiza, [tiza, open_file, "--no-save", "--socket", sock])
        self.pid, self.fd = pid, fd
        threading.Thread(target=self._drain, daemon=True).start()
        deadline = time.time() + 15
        while True:
            try:
                self.api("status")
                return
            except CheckFailed:
                if time.time() > deadline:
                    self.stop()
                    raise CheckFailed("Tiza did not answer on %s within 15 s" % sock)
                time.sleep(0.1)

    def _drain(self):
        while True:
            try:
                if not os.read(self.fd, 65536):
                    return
            except OSError:
                return

    def api(self, method, params=None):
        out = subprocess.run([self.tiza, "api", method, json.dumps(params or {}), "--socket", self.sock],
                             capture_output=True, text=True, timeout=30)
        if out.returncode != 0:
            raise CheckFailed("tiza api %s: %s" % (method, out.stderr.strip()))
        v = json.loads(out.stdout)
        return v.get("result", v) if isinstance(v, dict) else v

    def stop(self):
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.kill(self.pid, sig)
            except ProcessLookupError:
                break
            for _ in range(40):
                if os.waitpid(self.pid, os.WNOHANG)[0]:
                    break
                time.sleep(0.05)
            else:
                continue
            break
        try:
            os.waitpid(self.pid, 0)
        except ChildProcessError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass


class Bridge:
    """`tiza mcp` driven over JSON-RPC, as an MCP client would, in `cwd`."""

    def __init__(self, tiza, sock, cwd):
        self.proc = subprocess.Popen([tiza, "mcp", "--socket", sock], cwd=cwd, stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        self.next_id = 0
        self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "agent-trials", "version": "0"}})
        self._send({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.proc.stdin.close()
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            self.proc.wait()

    def _send(self, msg):
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def _rpc(self, method, params):
        self.next_id += 1
        self._send({"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params})
        while True:
            line = self.proc.stdout.readline()
            need(line, "tiza mcp closed its output")
            msg = json.loads(line)
            if msg.get("id") == self.next_id:
                return msg

    def call(self, tool, arguments):
        msg = self._rpc("tools/call", {"name": tool, "arguments": arguments})
        res = msg.get("result") or {}
        text = " ".join(c.get("text", "") for c in res.get("content", []) if isinstance(c, dict))
        return {"error": bool(res.get("isError") or "error" in msg), "text": text or str(msg.get("error"))}


def prepare(task, broken):
    """A fresh /tmp directory: work/ (only the fixture) and the socket path."""
    base = tempfile.mkdtemp(prefix="tiza-trial-", dir="/tmp")
    try:
        work = os.path.join(base, "work")
        os.mkdir(work)
        src, names = fixture_files(task)
        for n in names:
            shutil.copy(os.path.join(src, n), os.path.join(work, n))
        if broken and task["break"][0] == "mkdir":
            os.mkdir(os.path.join(work, task["break"][1]))
        elif broken:
            name, old, new = task["break"]
            p = os.path.join(work, name)
            with open(p) as f:
                text = f.read()
            assert old in text, "break of %s: %r not in %s" % (task["id"], old, name)
            with open(p, "w") as f:
                f.write(text.replace(old, new))
    except BaseException:
        shutil.rmtree(base, ignore_errors=True)
        raise
    return base, work, os.path.join(base, "t.sock")


def run_check(task, inst, work, rec):
    try:
        task["check"](inst, work, rec)
        return True, ""
    except CheckFailed as e:
        return False, str(e)
    except Exception as e:  # a check that crashes is a failed trial, never a pass
        return False, "check crashed: %r" % e


# ------------------------------------------------------------ measurement ----

# Error texts that mean the arguments were wrong (a heuristic: the bridge
# reports instance errors as invalid_params with the instance's code in the
# message, rejects arguments that do not fit the tool's schema with "failed to
# deserialize parameters", and Claude Code rejects a schema mismatch as
# InputValidationError).
INVALID_ARGS = re.compile(r"invalid_argument|text_not_found|out_of_range|invalid_params|InputValidationError|"
                          r"-32602|failed to deserialize|missing field|unknown field")


def parse_stream(lines):
    """Claude Code's stream-json → the trial's measured figures.

    Usage is per API request: assistant messages that share a message id carry
    the same usage, so they are counted once. Output tokens come from the
    result message (per-request output is a placeholder in the stream)."""
    init, result = {}, {}
    requests = []          # [{id, usage, tools: [names]}] in order
    by_id = {}
    calls = []             # [{id, name, input, error, error_text}] in order
    call_by_id = {}
    for raw in lines:
        raw = raw.strip()
        if not raw:
            continue
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        kind = ev.get("type")
        if kind == "system" and ev.get("subtype") == "init":
            init = ev
        elif kind == "assistant":
            msg = ev.get("message", {})
            mid = msg.get("id") or "#%d" % len(requests)
            if mid not in by_id:
                by_id[mid] = {"id": mid, "usage": msg.get("usage") or {}, "tools": []}
                requests.append(by_id[mid])
            for block in msg.get("content") or []:
                if block.get("type") == "tool_use" and block.get("id") not in call_by_id:
                    call = {"id": block.get("id"), "name": block.get("name") or "", "input": block.get("input") or {},
                            "error": False, "error_text": ""}
                    by_id[mid]["tools"].append(call["name"])
                    call_by_id[call["id"]] = call
                    calls.append(call)
        elif kind == "user":
            for block in (ev.get("message", {}).get("content") or []):
                if isinstance(block, dict) and block.get("type") == "tool_result" and block.get("is_error"):
                    content = block.get("content")
                    if isinstance(content, list):
                        content = " ".join(c.get("text", "") for c in content if isinstance(c, dict))
                    call = call_by_id.get(block.get("tool_use_id"))
                    if call:
                        call["error"], call["error_text"] = True, str(content)[:300]
        elif kind == "result":
            result = ev

    def ctx(u):
        return {"input": u.get("input_tokens", 0), "cache_read": u.get("cache_read_input_tokens", 0),
                "cache_write": u.get("cache_creation_input_tokens", 0)}

    def total(c):
        return c["input"] + c["cache_read"] + c["cache_write"]

    first = ctx(requests[0]["usage"]) if requests else None
    first_tiza = next((ctx(r["usage"]) for r in requests
                       if any(n.startswith("mcp__tiza__") for n in r["tools"])), None)
    sums = {"input": 0, "cache_read": 0, "cache_write": 0}
    for r in requests:
        for k, v in ctx(r["usage"]).items():
            sums[k] += v
    rusage = result.get("usage") or {}
    # A retry: a call of a tool that failed earlier in the trial.
    retries = sum(1 for i, c in enumerate(calls) if any(p["error"] and p["name"] == c["name"] for p in calls[:i]))
    errors = [c for c in calls if c["error"]]
    servers = init.get("mcp_servers") or []
    return {
        "model": init.get("model") or ",".join((result.get("modelUsage") or {}).keys()),
        "models_used": sorted((result.get("modelUsage") or {}).keys()),
        "tools_offered": init.get("tools") or [],
        "mcp_servers": servers,
        "mcp_ok": [s.get("name") for s in servers] == ["tiza"] and servers[0].get("status") == "connected",
        "session": {k: init.get(k) for k in ("plugins", "skills", "permissionMode", "apiKeySource",
                                               "output_style", "claude_code_version", "cwd") if k in init},
        "requests": len(requests),
        "ctx_first_request": first,
        "ctx_first_request_total": total(first) if first else None,
        "ctx_first_tiza_call": first_tiza,
        "ctx_first_tiza_call_total": total(first_tiza) if first_tiza else None,
        "ctx_peak_total": max((total(ctx(r["usage"])) for r in requests), default=None),
        "ctx_last_request_total": total(ctx(requests[-1]["usage"])) if requests else None,
        "input": sums,
        "input_total": total(sums),
        "output": rusage.get("output_tokens"),
        "calls": [{"name": c["name"], "input": c["input"], "error": c["error"]} for c in calls],
        "tiza_calls": sum(1 for c in calls if c["name"].startswith("mcp__tiza__")),
        "tool_search_calls": sum(1 for c in calls if c["name"] == "ToolSearch"),
        "other_tool_calls": sorted(c["name"] for c in calls
                                   if not c["name"].startswith("mcp__tiza__") and c["name"] != "ToolSearch"),
        "tool_errors": len(errors),
        "invalid_arguments": sum(1 for c in errors if INVALID_ARGS.search(c["error_text"])),
        "retries": retries,
        "error_samples": [(c["name"], c["error_text"]) for c in errors[:5]],
        "cost_usd": result.get("total_cost_usd"),
        "num_turns": result.get("num_turns"),
        "duration_ms": result.get("duration_ms"),
        "result_subtype": result.get("subtype"),
        "answer": result.get("result"),
        "self_report_tokens": self_report(result.get("result") or ""),
    }


def self_report(answer):
    """The number in the agent's last `CONTEXT:` line (12k, 12,000, ~1.2M, **CONTEXT:** about 9000)."""
    found = re.findall(r"CONTEXT\W*?:\W*?(?:about|around|roughly|~|≈|\s)*([\d][\d,.]*)\s*([kKmM])?", answer, re.I)
    if not found:
        return None
    digits, unit = found[-1]
    if re.fullmatch(r"\d{1,3}([.,]\d{3})+", digits):
        n = float(re.sub(r"[.,]", "", digits))          # 12,000 or 12.000
    else:
        n = float(digits.replace(",", ""))
    return int(n * {"k": 1e3, "m": 1e6}.get(unit.lower(), 1) if unit else n)


# ------------------------------------------------------------------ trial ----


def mcp_config(tiza, sock):
    return json.dumps({"mcpServers": {"tiza": {"command": tiza, "args": ["mcp", "--socket", sock]}}})


def claude_command(args, task, sock):
    prompt = task["prompt"] + "\n\n" + SELF_REPORT
    return [
        args.claude, "-p", prompt,
        "--output-format", "stream-json", "--verbose",
        "--model", args.model or "<model>",
        "--setting-sources", "project",
        "--strict-mcp-config", "--mcp-config", mcp_config(args.tiza, sock),
        "--tools", args.builtin_tools,
        "--allowedTools", "mcp__tiza__*,ToolSearch",
        "--permission-mode", "dontAsk",
        "--disable-slash-commands", "--no-session-persistence",
        "--max-budget-usd", "%.2f" % args.trial_budget,
        "--max-turns", str(args.max_turns),
    ]


def claude_env(variant):
    env = dict(os.environ)
    for k in variant["unset"]:
        env.pop(k, None)
    env.update(BASE_ENV)
    env.update(variant["env"])
    return env


def run_claude(cmd, cwd, env, raw, timeout):
    """claude in its own process group, killed whole on timeout."""
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=raw,
                            stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        _, err = proc.communicate(timeout=timeout)
        return proc.returncode, err[-2000:]
    except BaseException as e:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.wait()
        if isinstance(e, subprocess.TimeoutExpired):
            return None, "timed out after %ds" % timeout
        raise


def run_trial(args, n, task, vname, out_dir):
    variant = VARIANTS[vname]
    broken = args.break_task == task["id"]
    stem = "%02d-%s-%s" % (n, task["id"], vname)
    rec = {"n": n, "task": task["id"], "variant": vname, "broken_on_purpose": broken,
           "model_requested": args.model}
    base, inst = None, None
    try:
        base, work, sock = prepare(task, broken)
        try:
            inst = Instance(args.tiza, work, task["open"], sock)
        except CheckFailed as e:
            rec.update(success=False, why="Tiza did not start, no agent ran: %s" % e)
            return rec
        t0 = time.time()
        with open(os.path.join(out_dir, stem + ".jsonl"), "w") as raw:
            rec["exit"], rec["stderr"] = run_claude(claude_command(args, task, sock), work, claude_env(variant),
                                                    raw, args.timeout)
        rec["wall_s"] = round(time.time() - t0, 1)
        with open(os.path.join(out_dir, stem + ".jsonl")) as raw:
            rec.update(parse_stream(raw))
        ok, why = run_check(task, inst, work, rec)
        if rec.get("tiza_calls", 0) == 0:
            ok, why = False, "the agent never called a tiza tool" + ("; " + why if why else "")
        if not rec.get("mcp_ok"):
            why = "tiza mcp was not connected (%s); %s" % (rec.get("mcp_servers"), why)
            ok = False
        rec["success"], rec["why"] = ok, why
        rec["tool_search_offered"] = "ToolSearch" in rec.get("tools_offered", [])
    finally:
        if inst:
            inst.stop()
        if base:
            shutil.rmtree(base, ignore_errors=True)
        with open(os.path.join(out_dir, stem + ".json"), "w") as f:
            json.dump(rec, f, indent=2)
    return rec


# ----------------------------------------------------------------- report ----


def fmt(n):
    return "—" if n is None else "{:,}".format(n)


def table(records, meta):
    lines = ["Model %s · %s · tiza %s · claude %s" % (meta.get("model"), meta.get("stamp"), meta.get("tiza_commit"),
                                                     meta.get("claude_version")), ""]
    lines.append("| # | task | variant | ok | ctx 1st request | ctx at 1st tiza call | ctx peak | input total (fresh /"
                 " cache read / write) | output | tiza calls | tool search | errors (invalid args) | retries"
                 " | other tools | turns | wall s | cost $ | self-report |")
    lines.append("|" + "---|" * 18)
    for r in records:
        i = r.get("input") or {}
        lines.append("| %d | %s | %s | %s | %s | %s | %s | %s (%s / %s / %s) | %s | %s | %s | %s (%s) | %s | %s | %s"
                     " | %s | %s | %s |" % (
                         r["n"], r["task"] + (" (broken)" if r.get("broken_on_purpose") else ""), r["variant"],
                         "yes" if r.get("success") else "**no**",
                         fmt(r.get("ctx_first_request_total")), fmt(r.get("ctx_first_tiza_call_total")),
                         fmt(r.get("ctx_peak_total")),
                         fmt(r.get("input_total")), fmt(i.get("input")), fmt(i.get("cache_read")),
                         fmt(i.get("cache_write")), fmt(r.get("output")), fmt(r.get("tiza_calls")),
                         fmt(r.get("tool_search_calls")), fmt(r.get("tool_errors")), fmt(r.get("invalid_arguments")),
                         fmt(r.get("retries")), ", ".join(r.get("other_tool_calls") or []) or "—",
                         fmt(r.get("num_turns")), r.get("wall_s", "—"),
                         "—" if r.get("cost_usd") is None else "%.3f" % r["cost_usd"],
                         fmt(r.get("self_report_tokens"))))
    fails = ["- #%d %s/%s: %s" % (r["n"], r["task"], r["variant"], r.get("why")) for r in records if not r.get("success")]
    return "\n".join(lines) + ("\n\nFailures:\n" + "\n".join(fails) if fails else "") + "\n"


# ------------------------------------------------------------------- main ----


def plan(args, cap=True):
    tasks = [t for t in TASKS if not args.tasks or t["id"] in args.tasks]
    variants = [v for v in VARIANTS if not args.variants or v in args.variants]
    trials = [(t, v) for _ in range(args.repeats) for t in tasks for v in variants]
    return trials[:args.max_trials] if cap and args.max_trials else trials


def find_claude():
    on_path = shutil.which("claude")
    if on_path:
        return on_path
    return os.path.expanduser("~/.local/bin/claude")


def build_tiza():
    out = subprocess.run(["cargo", "build", "-p", "tiza", "--quiet"], cwd=ROOT)
    if out.returncode != 0:
        sys.exit("agent-trials: building tiza failed")
    return os.path.join(ROOT, "target", "debug", "tiza")


def output_of(cmd, cwd=None):
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=30).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def self_check(args):
    """No model: each task's check must fail on its untouched fixture, pass after
    the scripted solution, and fail again when the fixture is broken."""
    bad = 0
    for task in TASKS:
        if args.tasks and task["id"] not in args.tasks:
            continue
        for broken in (False, True):
            base, work, sock = prepare(task, broken)
            try:
                inst = Instance(args.tiza, work, task["open"], sock)
            except CheckFailed as e:
                shutil.rmtree(base, ignore_errors=True)
                print("%-11s BAD %s Tiza did not start: %s" % (task["id"], "broken" if broken else "untouched", e))
                bad += 1
                continue
            try:
                before, _ = run_check(task, inst, work, {"answer": "", "calls": []})
                try:
                    rec = task["oracle"](inst, work) or {}
                except CheckFailed as e:
                    rec = {"answer": "oracle failed: %s" % e}
                rec.setdefault("calls", [])
                after, why_after = run_check(task, inst, work, rec)
            finally:
                inst.stop()
                shutil.rmtree(base, ignore_errors=True)
            if broken:
                good = not after
                line = "broken fixture + solution → %s" % ("FAIL (as it must)" if good else "PASS (wrong!)")
            else:
                good = not before and after
                line = "untouched → %s; solution → %s" % ("FAIL" if not before else "PASS (wrong!)",
                                                          "PASS" if after else "FAIL: " + why_after)
            bad += not good
            print("%-11s %s %s" % (task["id"], "ok " if good else "BAD", line))
    # The stream parser on a recorded sample (fixtures/sample-stream.jsonl).
    with open(os.path.join(FIXTURES, "sample-stream.jsonl")) as f:
        m = parse_stream(f)
    want = {"requests": 3, "ctx_first_request_total": 21000, "ctx_first_tiza_call_total": 23500,
            "input_total": 70000, "output": 900, "tiza_calls": 2, "tool_search_calls": 1,
            "tool_errors": 1, "invalid_arguments": 1, "retries": 1, "self_report_tokens": 12000,
            "other_tool_calls": [], "mcp_ok": True, "ctx_peak_total": 25500, "ctx_last_request_total": 25500}
    wrong = {k: (m.get(k), v) for k, v in want.items() if m.get(k) != v}
    for text in ("failed to deserialize parameters: missing field `id`", "unknown field `foo`",
                 "text \"x\" not found (text_not_found)", "InputValidationError: from_line"):
        if not INVALID_ARGS.search(text):
            wrong[text] = "not counted as invalid arguments"
    if INVALID_ARGS.search("the presenter rejected this change (rejected)"):
        wrong["rejected"] = "counted as invalid arguments"
    for text, n in (("CONTEXT: 12k tokens - x", 12000), ("**CONTEXT:** about 12,000 tokens", 12000),
                    ("context: ~1.2M", 1200000), ("CONTEXT: 9000 then\nCONTEXT: 15k tokens", 15000),
                    ("CONTEXT: 12.000 tokens", 12000), ("no line", None)):
        if self_report(text) != n:
            wrong[text] = (self_report(text), n)
    print("%-11s %s %s" % ("stream", "BAD" if wrong else "ok ", wrong or "sample stream and self-reports parsed as expected"))
    bad += bool(wrong)
    print("self-check: %s" % ("all good" if not bad else "%d problem(s)" % bad))
    return 1 if bad else 0


def write_summary(out_dir, meta, records):
    with open(os.path.join(out_dir, "summary.json"), "w") as f:
        json.dump(dict(meta, trials=records), f, indent=2)
    md = table(records, meta)
    with open(os.path.join(out_dir, "summary.md"), "w") as f:
        f.write(md)
    return md


def report(out_dir):
    """Re-parse a finished run's streams (after a change to the measurements)."""
    try:
        with open(os.path.join(out_dir, "summary.json")) as f:
            summary = json.load(f)
        trials = summary.pop("trials")
    except (OSError, ValueError, KeyError):
        # A run that stopped before writing its summary: rebuild it from the
        # per-trial results.
        summary, trials = {"stamp": os.path.basename(os.path.normpath(out_dir))}, []
        for name in sorted(os.listdir(out_dir)):
            if re.match(r"\d+-.*\.json$", name):
                with open(os.path.join(out_dir, name)) as f:
                    trials.append(json.load(f))
    records = []
    for rec in trials:
        stem = os.path.join(out_dir, "%02d-%s-%s" % (rec["n"], rec["task"], rec["variant"]))
        if os.path.exists(stem + ".jsonl"):
            with open(stem + ".jsonl") as raw:
                rec.update(parse_stream(raw))
            with open(stem + ".json", "w") as f:
                json.dump(rec, f, indent=2)
        records.append(rec)
    print(write_summary(out_dir, summary, records))
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0], add_help=True)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--self-check", action="store_true")
    p.add_argument("--model")
    p.add_argument("--max-trials", type=int)
    p.add_argument("--repeats", type=int, default=2)
    p.add_argument("--tasks", type=lambda s: s.split(","))
    p.add_argument("--variants", type=lambda s: s.split(","))
    p.add_argument("--break", dest="break_task")
    p.add_argument("--trial-budget", type=float, default=1.0)
    p.add_argument("--max-turns", type=int, default=40)
    p.add_argument("--timeout", type=int, default=600)
    p.add_argument("--out")
    p.add_argument("--tiza")
    p.add_argument("--claude")
    p.add_argument("--builtin-tools", default="ToolSearch")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--report")
    args = p.parse_args()
    if args.report:
        return report(args.report)

    for name, chosen, known in (("task", args.tasks, [t["id"] for t in TASKS]), ("variant", args.variants, VARIANTS)):
        for c in chosen or []:
            if c not in known:
                sys.exit("agent-trials: unknown %s %s (known: %s)" % (name, c, ", ".join(known)))
    if args.break_task and args.break_task not in [t["id"] for t in TASKS]:
        sys.exit("agent-trials: unknown task for --break: %s" % args.break_task)
    for name in ("max_trials", "repeats", "max_turns", "timeout"):
        v = getattr(args, name)
        if v is not None and v < 1:
            sys.exit("agent-trials: --%s must be at least 1" % name.replace("_", "-"))
    if args.trial_budget <= 0:
        sys.exit("agent-trials: --trial-budget must be above 0")
    args.claude = args.claude or find_claude()
    trials = plan(args)

    if args.dry_run:
        args.tiza = args.tiza or os.path.join(ROOT, "target", "debug", "tiza")
        full = plan(args, cap=False)
        print("plan: %d of %d trial(s) (%d repeat(s) x %d task(s) x %d variant(s), in that order); model %s; "
              "no model is called" % (len(trials), len(full), args.repeats, len({t["id"] for t, _ in full}),
                                      len({v for _, v in full}), args.model or "<--model>"))
        for name, v in VARIANTS.items():
            if not args.variants or name in args.variants:
                env = " ".join("%s=%s" % kv for kv in sorted(v["env"].items())) or "(nothing)"
                print("  variant %-15s %s; env %s%s" % (name, v["desc"], env,
                      "; unset " + ",".join(v["unset"]) if v["unset"] else ""))
        print("  every trial: env %s; a fresh /tmp/tiza-trial-*/work with only its fixture"
              % " ".join("%s=%s" % kv for kv in sorted(BASE_ENV.items())))
        for n, (task, vname) in enumerate(trials, 1):
            src, names = fixture_files(task)
            sock = "/tmp/tiza-trial-XXXXXX/t.sock"
            print("\n#%d %s × %s%s\n  fixture: %s/{%s}, Tiza opens %s\n  prompt: %s\n  command: %s"
                  % (n, task["id"], vname, "  (fixture broken on purpose)" if args.break_task == task["id"] else "",
                     os.path.relpath(src, ROOT), ",".join(names), task["open"], task["prompt"],
                     " ".join(shlex.quote(c) for c in claude_command(args, task, sock))))
        est = estimate(args.model, len(trials))
        print("\nestimate: %s" % ("about $%.2f per trial, $%.2f in all (rough; see PRICES/TRIAL_TOKENS)" % est
                                  if est else "pass --model (opus, sonnet, haiku, fable) for a spend estimate"))
        return 0

    args.tiza = os.path.abspath(args.tiza) if args.tiza else build_tiza()
    if args.self_check:
        return self_check(args)

    if not args.model:
        sys.exit("agent-trials: a real run needs --model (the comparison always uses one model)")
    if not os.path.exists(args.claude):
        sys.exit("agent-trials: claude not found (%s); --claude BIN" % args.claude)
    est = estimate(args.model, len(trials))
    print("%d trial(s) with %s; per-trial cap $%.2f (--max-budget-usd), so at most about $%.2f"
          % (len(trials), args.model, args.trial_budget, args.trial_budget * len(trials)))
    if est:
        print("estimate: about $%.2f per trial, $%.2f in all (rough)" % est)
    if not args.yes:
        if input("run them? [y/N] ").strip().lower() != "y":
            return 1
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out_dir = args.out or os.path.join(HERE, "runs", stamp)
    os.makedirs(os.path.join(out_dir, "bin"), exist_ok=True)
    # The binary under test, copied: a rebuild in the worktree during a long
    # run cannot swap it between trials.
    src_tiza, args.tiza = args.tiza, os.path.join(out_dir, "bin", "tiza")
    shutil.copy2(src_tiza, args.tiza)
    with open(args.tiza, "rb") as f:
        tiza_sha = hashlib.sha256(f.read()).hexdigest()
    dirty = output_of(["git", "status", "--porcelain", "--untracked-files=no"], ROOT)
    meta = {"model": args.model, "stamp": stamp, "claude": args.claude,
            "claude_version": output_of([args.claude, "--version"]),
            "tiza_commit": output_of(["git", "rev-parse", "--short", "HEAD"], ROOT) + ("+dirty" if dirty else ""),
            "tiza_version": output_of([args.tiza, "--version"]), "tiza_sha256": tiza_sha,
            "builtin_tools": args.builtin_tools, "repeats": args.repeats, "max_trials": args.max_trials,
            "trial_budget": args.trial_budget}
    records = []

    def on_term(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, on_term)
    stopped = None
    try:
        for n, (task, vname) in enumerate(trials, 1):
            print("#%d %s × %s …" % (n, task["id"], vname), end=" ", flush=True)
            rec = run_trial(args, n, task, vname, out_dir)
            records.append(rec)
            print("%s (%s requests, %s tokens in, $%s)%s" % (
                "ok" if rec.get("success") else "FAILED", rec.get("requests"), fmt(rec.get("input_total")),
                "—" if rec.get("cost_usd") is None else "%.3f" % rec["cost_usd"],
                "" if rec.get("success") else ": " + (rec.get("why") or "")))
            if VARIANTS[vname]["expects_tool_search"] and rec.get("tools_offered") and not rec.get("tool_search_offered"):
                stopped = ("variant %s has no ToolSearch in the session's tools %s; pass --builtin-tools "
                           "ToolSearch (or another value) and re-run" % (vname, rec["tools_offered"]))
                break
            if rec.get("mcp_servers") and not rec.get("mcp_ok"):
                stopped = "tiza mcp did not connect: %s" % rec["mcp_servers"]
                break
    except KeyboardInterrupt:
        stopped = "interrupted"
    meta["stopped"] = stopped
    md = write_summary(out_dir, meta, records)
    print("\n" + md)
    spent = sum(r.get("cost_usd") or 0 for r in records)
    unknown = sum(1 for r in records if r.get("cost_usd") is None and r.get("exit", 0) is None)
    print("spent $%.2f (Claude Code's total_cost_usd)%s; raw streams and results in %s" % (
        spent, " plus %d timed-out trial(s) whose cost the stream did not report" % unknown if unknown else "",
        out_dir))
    if stopped:
        print("agent-trials: the run stopped early: %s" % stopped)
        return 130 if stopped == "interrupted" else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
