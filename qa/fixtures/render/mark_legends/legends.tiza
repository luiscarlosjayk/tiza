{
  "schema": 1,
  "title": "mark legends",
  "source": {
    "language": "rs",
    "first_line": 1
  },
  "code": [
    "fn main() {",
    "    let s = String::from(\"hi\");",
    "    let t = s.clone();",
    "    let n = s.len();",
    "    let ok = n > 0;",
    "    let u = t;",
    "    let v = u;",
    "    println!(\"{v}\");",
    "    let w = 1;",
    "    let x = w + 1;",
    "    let y = x + 1;",
    "    println!(\"{y} {ok}\");",
    "}"
  ],
  "styles": {
    "new": {
      "glyph": "+",
      "color": "green",
      "legend": ""
    },
    "spaces": {
      "glyph": "~",
      "legend": "   "
    },
    "zero": {
      "glyph": "^",
      "legend": "\u200b"
    },
    "bare": {
      "legend": ""
    },
    "kept": {
      "glyph": "*",
      "color": "blue"
    }
  },
  "annotations": [
