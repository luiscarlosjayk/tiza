 "code": [
  "fn main() {",
  "    let a = 1;",
  "    let b = 2;",
  "",
  "    let c = a + b;",
  "    let d = c * 2;",
  "    let e = d - 1;",
  "",
  "    let f = e + a;",
  "    let g = f * b;",
  "",
  "    let h = g - c;",
  "    let i = h + d;",
  "    let j = i * e;",
  "    let k = j - f;",
  "    println!(\"{k}\");",
  "}"
 ],
