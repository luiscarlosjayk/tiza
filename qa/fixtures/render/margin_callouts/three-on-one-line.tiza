{"schema": 1, "title": "three callouts on L2", "source": {"language": "sh", "first_line": 1}, "code": ["DB_URL=postgres://demo:demo@localhost/app", "API_TOKEN=demo-token-123", "LOG_LEVEL=info", "PORT=8080", "WORKERS=4", "TIMEOUT=30", "RETRIES=3", "CACHE_TTL=600", "REGION=us-east-1", "FEATURE_X=on"], "annotations": [{"id": "c1", "step": 1, "type": "callout", "from_line": 2, "to_line": 2, "text": "rotate it every month", "placement": "margin"}, {"id": "c2", "step": 1, "type": "callout", "from_line": 2, "to_line": 2, "text": "never commit the real one to git", "placement": "margin"}, {"id": "c3", "step": 1, "type": "callout", "from_line": 2, "to_line": 2, "text": "the staging token is different and lives in vault under ops/staging", "placement": "margin"}]}