{"schema": 1, "title": "steps add callouts", "source": {"language": "sh", "first_line": 1}, "code": ["DB_URL=postgres://demo:demo@localhost/app", "API_TOKEN=demo-token-123", "LOG_LEVEL=info", "PORT=8080", "WORKERS=4", "TIMEOUT=30", "RETRIES=3", "CACHE_TTL=600", "REGION=us-east-1", "FEATURE_X=on"], "annotations": [{"id": "n2", "step": 1, "type": "note", "line": 2, "text": "bearer header"}, {"id": "c1", "step": 2, "type": "callout", "from_line": 2, "to_line": 2, "text": "rotate it every month", "placement": "margin"}, {"id": "c2", "step": 3, "type": "callout", "from_line": 2, "to_line": 2, "text": "never commit the real one", "placement": "margin"}, {"id": "n3", "step": 3, "type": "note", "line": 3, "text": "chatty"}, {"id": "c3", "step": 4, "type": "callout", "from_line": 3, "to_line": 3, "text": "debug shows SQL", "placement": "margin"}, {"id": "b", "step": 5, "type": "box", "from_line": 1, "to_line": 4, "label": "env"}]}