 "code": [
  "struct Player {}",
  "",
  "impl Player {",
  "    fn new() -> Self {",
  "        println!(\"Creating player!\");",
  "        Player {}",
  "    }",
  "}",
  "",
  "impl Drop for Player {",
  "    fn drop(&mut self) {",
  "        println!(\"Dropping player!\");",
  "    }",
  "}",
  "",
  "fn main() {",
  "}"
 ],
