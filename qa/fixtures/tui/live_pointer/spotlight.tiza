{"schema": 1, "title": "pointer and spotlight", "source": {"language": "rs", "first_line": 1}, "code": ["fn main() {", "    let s = String::from(\"hi\");", "    let t = s;", "    let u = t.clone();", "    takes(t);", "    let n = u.len();", "}", "", "fn takes(v: String) {", "    println!(\"{v}\");", "    drop(v);", "}"], "annotations": [{"id": "m1", "step": 1, "type": "mark", "kind": "move", "span": {"line": 3, "start": 12, "end": 13}, "label": "s moves"}, {"id": "h1", "step": 1, "type": "highlight", "span": {"line": 6, "start": 8, "end": 9}, "label": "the length"}, {"id": "b1", "step": 1, "type": "box", "from_line": 9, "to_line": 11, "label": "the callee"}, {"id": "a1", "step": 1, "type": "arrow", "from": {"line": 5, "col": 10}, "to": {"line": 10, "col": 15}, "label": "goes in"}, {"id": "n1", "step": 1, "type": "note", "line": 12, "text": "far away"}, {"id": "S1", "step": 2, "type": "spotlight", "from_line": 1, "to_line": 2}]}
