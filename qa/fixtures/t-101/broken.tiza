{
  "schema": 1,
  "title": "Every error check knows",
  "source": { "language": "rs", "first_line": 1 },
  "code": [
    "fn main() {",
    "    let s = String::from(\"hi\");",
    "    takes(s);",
    "}",
    "",
    "fn takes(s: String) {",
    "    println!(\"{s}\");",
    "}"
  ],
  "moves": [
    { "at_step": 2, "action": "code.patch", "op": "replace", "find": "takes", "content": "    takes(s.clone());" },
    { "at_step": 2, "action": "code.patch", "op": "insert", "after": "no such line", "content": "    // x" },
    { "at_step": 3, "action": "code.patch", "op": "delete", "find": "println", "rebind": { "zz": { "at": { "line": 1, "col": 0 } } } },
    { "at_step": 4, "action": "code.link", "file": "gone.rs" },
    { "at_step": 4, "action": "code.patch", "op": "insert", "position": "1", "content": "// in gone.rs" },
    { "at_step": 5, "action": "code.link", "file": "gone.rs", "lines": "1-3" }
  ],
  "annotations": [
    { "id": "a1", "step": 1, "type": "note", "line": 99, "text": "past the end" },
    { "id": "a2", "step": 1, "type": "mark", "kind": "move", "span": { "line": 3, "start": 10, "end": 11 } },
    { "id": "a2", "step": 1, "type": "note", "line": 2, "text": "same id again" },
    { "id": "s1", "step": 1, "type": "spotlight", "ids": ["a2", "nobody"] },
    { "id": "b1", "step": 1, "type": "box", "from_line": 6, "to_line": 8, "markers": { "start": "fn takes", "end": "no such end" } },
    { "id": "g1", "step": 4, "file": "gone.rs", "type": "note", "line": 1, "text": "in a file that is not there" },
    { "id": "g2", "step": 5, "file": "gone.rs", "type": "note", "line": 2, "text": "also there" }
  ]
}
