{
  "schema": 1,
  "title": "Follow reload with code.link",
  "source": {"language": "rs", "first_line": 1},
  "code": {"file": "main.rs"},
  "step": 0,
  "steps": [{"step": 4, "id": "back", "title": "Back to main"}, {"step": 7, "id": "last", "title": "Last"}],
  "annotations": [
    {"id": "n0", "step": 0, "type": "note", "line": 9, "text": "prints it"},
    {"id": "q3", "step": 3, "file": "src/queue.rs", "type": "note", "line": 2, "text": "the items"},
    {"id": "m5", "step": 5, "type": "note", "line": 3, "text": "moved"}
  ],
  "moves": [
    {"at_step": 1, "action": "cursor", "line": 3},
    {"at_step": 2, "action": "select", "from": {"find": "let s"}, "to": {"find": "takes(s);"}},
    {"at_step": 3, "action": "code.link", "file": "src/queue.rs"},
    {"at_step": 4, "action": "code.link", "file": "main.rs"},
    {"at_step": 5, "action": "code.patch", "op": "replace", "find": "takes(s);", "content": "    takes(s); // moved here"},
    {"at_step": 5, "action": "code.link", "file": "src/queue.rs"},
    {"at_step": 6, "action": "code.link", "file": "main.rs"},
    {"at_step": 7, "action": "code.patch", "op": "replace", "find": "println!(\"{s}\");", "content": "    println!(\"{s}!\");"}
  ]
}
