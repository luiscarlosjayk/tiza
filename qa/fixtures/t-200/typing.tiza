{
  "schema": 1,
  "title": "Two labels on L1 while step 2 types a line in (t-200)",
  "source": {
    "language": "sh",
    "first_line": 1
  },
  "code": [
    "DB_URL=postgres://demo:demo@localhost/app",
    "API_TOKEN=demo-token-123",
    "LOG_LEVEL=info",
    "PORT=8080"
  ],
  "annotations": [
    {
      "id": "h1",
      "step": 1,
      "type": "highlight",
      "span": {
        "line": 1,
        "start": 7,
        "end": 41
      },
      "label": "the key"
    },
    {
      "id": "n1",
      "step": 2,
      "type": "note",
      "line": 1,
      "text": "DB connection string"
    },
    {
      "id": "n3",
      "step": 1,
      "type": "note",
      "line": 3,
      "text": "how chatty the logs are"
    }
  ],
  "moves": [
    {
      "at_step": 2,
      "action": "code.patch",
      "op": "insert",
      "after": "PORT=8080",
      "content": "\nWORKERS=4",
      "typing": "char",
      "speed_ms": 25
    }
  ]
}
