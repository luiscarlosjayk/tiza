{"schema": 1, "title": "callouts on L2 L3 L4", "source": {"language": "sh", "first_line": 1}, "code": ["DB_URL=postgres://demo:demo@localhost/app", "API_TOKEN=demo-token-123", "LOG_LEVEL=info", "PORT=8080", "WORKERS=4", "TIMEOUT=30", "RETRIES=3", "CACHE_TTL=600", "REGION=us-east-1", "FEATURE_X=on"], "annotations": [{"id": "c2", "step": 1, "type": "callout", "from_line": 2, "to_line": 2, "text": "rotate it every month; the old one stops after an hour", "placement": "margin"}, {"id": "c3", "step": 1, "type": "callout", "from_line": 3, "to_line": 3, "text": "debug shows every SQL query with timings", "placement": "margin"}, {"id": "c4", "step": 1, "type": "callout", "from_line": 4, "to_line": 4, "text": "the port the server listens on", "placement": "margin"}]}