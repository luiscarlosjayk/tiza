  "code": [
    "struct Stack {",
    "    items: Vec<i32>,",
    "}",
    "",
    "impl Stack {",
    "    fn push(&mut self, x: i32) {",
    "        self.items.push(x);",
    "    }",
    "",
    "    fn pop(&mut self) -> Option<i32> {",
    "        self.items.pop()",
    "    }",
    "}"
