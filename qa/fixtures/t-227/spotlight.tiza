{"schema": 1, "source": {"language": "rs", "first_line": 1}, "code": ["fn main() {", "    let s = String::from(\"hi\");", "    takes(s);", "    let t = 2;", "}", "", "fn takes(s: String) {", "    println!(\"{s}\");", "}"], "annotations": [{"id": "n1", "step": 1, "type": "note", "line": 2, "text": "s is born"}, {"id": "a1", "step": 2, "type": "arrow", "from": {"line": 3, "col": 10}, "to": {"line": 7, "col": 3}, "label": "move: s moves into takes and is gone"}, {"id": "c1", "step": 2, "type": "callout", "from_line": 7, "to_line": 9, "text": "takes owns s and frees it at the end of the function body"}, {"id": "sp", "step": 2, "type": "spotlight", "from_line": 7, "to_line": 9}]}